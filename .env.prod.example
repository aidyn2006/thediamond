# Copy to .env and fill in. Used by docker-compose.nginx.yml.

# Domain that points to this VPS (host nginx + certbot issue TLS for it)
DOMAIN=thediamond.example.com

# Host ports the containers publish on 127.0.0.1 (host nginx proxies to them)
FRONTEND_HOST_PORT=3002
BACKEND_HOST_PORT=8082

# PostgreSQL
POSTGRES_DB=thediamond
POSTGRES_USER=thediamond
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Backend JWT signing secret (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars_secret

# Auth.js session secret. Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_authjs_secret

# Google Analytics 4 measurement id. Read at BUILD time (NEXT_PUBLIC_*), so after
# changing it the frontend image must be rebuilt: docker compose up -d --build frontend
NEXT_PUBLIC_GA_ID=G-W1FKFZPGVS

# Site-ownership tokens. Unlike the GA id these are read at RUNTIME, so changing them
# needs only a restart. Paste the content="..." value each tool shows you.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Email via SMTP (Mail.ru). When MAIL_SMTP_HOST is set, SMTP is used instead of Resend.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

# Fallback: Resend (leave everything empty to log emails to the backend console)
RESEND_API_KEY=
MAIL_FROM=TheDiamond <onboarding@resend.dev>
